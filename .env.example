# 复制为 .env 后按需修改
# SQLite 连接串。本地开发用文件即可；Docker 中指向挂载卷 /data
DATABASE_URL=sqlite://data/mtab.db?mode=rwc

# 站点图标缓存目录。图标字节写在磁盘上，库里只留元数据（详见 README）。
# Docker 中要指到挂载卷里（/data/icon），否则容器重建缓存就没了。
ICON_DIR=data/icon

# 上传的壁纸目录（设置 → 外观 → 壁纸）。这是用户数据、不参与缓存清理，
# 所以更要放在挂载卷里（Docker 中为 /data/wallpaper）。
WALLPAPER_DIR=data/wallpaper

# 监听地址与端口（Docker 中 IP 用 0.0.0.0）
# 注意变量名是 IP，不是 HOST —— 由 dioxus-cli-config 读取
IP=127.0.0.1
PORT=8080
